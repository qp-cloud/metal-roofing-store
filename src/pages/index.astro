---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { testimonials } from '../data/testimonials';
import FacebookUpdates from '../components/FacebookUpdates.astro';
import ConfiguratorCTA from '../components/ConfiguratorCTA.astro';
---

<BaseLayout
  lang="th"
  title="หจก.มีชัยสตีล หนองคาย | โรงงานผลิตแผ่นหลังคาเหล็กและแผ่นฉนวน ส่งไทย–ลาว"
  description="โรงงานผลิตแผ่นหลังคาเหล็กและแผ่นฉนวน PU Foam ที่หนองคาย รับงานผู้รับเหมาและโครงการ ตัดตามความยาวหน้างาน จัดส่งอีสานตอนบนและ สปป.ลาว"
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">โรงงานผลิตที่หนองคาย · ส่งอีสานตอนบนและ สปป.ลาว</p>
        <h1>แผ่นหลังคาเหล็กจากโรงงาน สำหรับงานผู้รับเหมาและโครงการ</h1>
        <p class="hero__lede">
          ผลิตเอง ตัดตามความยาวหน้างาน คุมสเปกให้เหมือนกันทั้งโครงการ
          พร้อมทีมช่างเทคนิคช่วยคำนวณปริมาณวัสดุก่อนสั่งผลิต
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact">ขอใบเสนอราคาโครงการ</a>
          <a class="btn btn--outline" href={site.lineHref} target="_blank" rel="noopener noreferrer">สอบถามทาง LINE</a>
        </div>
      </div>
      <div class="hero__media" role="img" aria-label="แผ่นหลังคาเหล็กมีชัยสตีลติดตั้งบนโรงงาน"></div>
    </div>
  </section>

  <ConfiguratorCTA lang="th" />

  <section class="section" data-reveal-group>
    <div class="container">
      <h2>สินค้าของเรา</h2>
      <div class="grid-auto">
        {products.map((p) => (
          <a class="product-card reveal" href={`/products#${p.slug}`}>
            <h3>{p.nameTh}</h3>
            <p>{p.descTh}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <h2>ทำไมต้องมีชัยสตีล</h2>
      <div class="grid-auto" data-reveal-group>
        <div class="point reveal">
          <h3>สั่งผลิตตามความยาวหน้างาน</h3>
          <p>ตัดตามความยาวจริงของแต่ละช่วงหลังคา ลดรอยต่อ ลดเศษเหลือ และลดงานตัดหน้างาน</p>
        </div>
        <div class="point reveal">
          <h3>คำนวณปริมาณวัสดุให้ก่อนสั่ง</h3>
          <p>ส่งแบบมา ทีมช่างเทคนิคช่วยถอดปริมาณ (Taking-off) และแนะนำระบบยึดที่เหมาะกับงาน</p>
        </div>
        <div class="point reveal">
          <h3>ส่งข้ามแดนไป สปป.ลาว</h3>
          <p>อยู่ติดสะพานมิตรภาพไทย–ลาว แห่งที่ 1 ห่างเวียงจันทน์ประมาณ 25 กม.</p>
        </div>
        <div class="point reveal">
          <h3>ใบเสนอราคาตามงานจริง</h3>
          <p>คิดราคาตามสเปก ปริมาณ และหน้างานจริง แจ้งชัดเจนก่อนสั่งผลิต</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>เสียงจากลูกค้า</h2>
      <div class="grid-auto" data-reveal-group>
        {testimonials.map((t) => (
          <blockquote class="quote reveal">
            <p>&ldquo;{t.quoteTh}&rdquo;</p>
            <footer>
              <strong>{t.nameTh}</strong> — {t.projectTh}
              <span class="quote__branch">{t.branchTh}</span>
            </footer>
          </blockquote>
        ))}
      </div>
      <p class="section-cta"><a href="/testimonials">ดูรีวิวทั้งหมด &rarr;</a></p>
    </div>
  </section>

  <FacebookUpdates lang="th" />

  <section class="section section--surface cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>พร้อมเริ่มโครงการหลังคาของคุณ?</h2>
        <p>ทักแชท LINE หรือโทรหาทีมขาย รับคำปรึกษาฟรีก่อนตัดสินใจ</p>
      </div>
      <div class="hero__actions">
        <a class="btn btn--primary" href={site.lineHref} target="_blank" rel="noopener noreferrer">แชท LINE: {site.lineId}</a>
        <a class="btn btn--outline" href={site.phoneHref}>โทร {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
    background: var(--color-surface);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__lede {
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .hero__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
  }

  .product-card {
    display: block;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color 180ms var(--ease-out-quart), transform 180ms var(--ease-out-quart);
  }

  .product-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .product-card h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-1);
  }

  .product-card p {
    color: var(--color-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .point h3 {
    font-size: 1.1rem;
  }

  .point p {
    color: var(--color-muted);
    margin: 0;
  }

  .quote {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin: 0;
  }

  .quote p {
    font-style: italic;
    max-width: none;
  }

  .quote footer {
    font-style: normal;
    font-size: 0.9rem;
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .quote__branch {
    font-size: 0.82rem;
  }

  .section-cta {
    margin-top: var(--space-4);
  }

  .section-cta a {
    text-decoration: none;
    font-weight: 600;
  }

  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  @media (max-width: 800px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__media {
      order: -1;
    }
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
</style>
