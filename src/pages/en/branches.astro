---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { location, hasAddress, serviceArea } from '../../data/branches';
---

<BaseLayout
  lang="en"
  title="Location & Contact | Meechai Steel Ltd., Part."
  description="Where to find Meechai Steel, plus phone, LINE and Facebook contact details."
>
  <section class="page-hero">
    <div class="container">
      <h1>Location & Contact</h1>
      <p>We operate from a single site — manufacturing, delivery and installation all in-house.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div class="location-card">
        <h2>{location.nameEn}</h2>
        <p class="location-card__province">{location.provinceEn}</p>
        {hasAddress ? (
          <p class="location-card__address">{location.addressEn}</p>
        ) : (
          <p class="location-card__pending">The full street address is being finalised — please reach us by phone or LINE below.</p>
        )}
        <ul class="phone-list">
          {location.phones.map((p) => (
            <li>
              <a href={p.href}>{p.display}</a>
              <span class="phone-list__label">{p.labelEn}</span>
            </li>
          ))}
        </ul>
        <div class="hero__actions">
          <a class="btn btn--primary" href={site.lineHref} target="_blank" rel="noopener noreferrer">Chat on LINE</a>
          <a class="btn btn--outline" href={site.facebookHref} target="_blank" rel="noopener noreferrer">View Facebook</a>
        </div>
        {location.mapUrl && (
          <p class="location-card__map"><a href={location.mapUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps &rarr;</a></p>
        )}
      </div>
    </div>
  </section>
  <section class="section section--surface">
    <div class="container-narrow">
      <h2>Delivery area</h2>
      <dl class="area-list">
        <dt>Domestic</dt>
        <dd>{serviceArea.domesticEn}</dd>
        <dt>Cross-border</dt>
        <dd>{serviceArea.crossBorderEn}</dd>
      </dl>
      <p class="area-note">
        Outside these areas, ask us — we price freight on the actual volume and distance.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-surface);
  }

  .page-hero p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .location-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }

  .location-card h2 {
    margin-top: 0;
  }

  .location-card__address {
    color: var(--color-ink);
  }

  .location-card__pending {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .location-card__map {
    margin-bottom: 0;
  }

  .location-card__map a {
    font-weight: 600;
    text-decoration: none;
  }

  .phone-list {
    list-style: none;
    margin: var(--space-3) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .phone-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .phone-list a {
    font-weight: 600;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .phone-list__label {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .location-card__province {
    font-weight: 600;
    margin: 0 0 var(--space-1);
  }

  .area-list {
    margin: 0;
  }

  .area-list dt {
    font-weight: 600;
    margin-top: var(--space-3);
  }

  .area-list dd {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
  }

  .area-note {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
