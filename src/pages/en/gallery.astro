---
import BaseLayout from '../../layouts/BaseLayout.astro';
import galleryManifest from '../../data/gallery-manifest.json';

const INITIAL_BATCH = 48;
const initial = galleryManifest.slice(0, INITIAL_BATCH);
const total = galleryManifest.length;
const altFor = (i: number) => `Meechai Steel roofing installation photo ${i + 1}`;
---

<BaseLayout
  lang="en"
  title="Our Work | Meechai Steel Ltd., Part."
  description={`Over ${total} real installation photos of metal roofing and insulated panels from Meechai Steel's job sites.`}
>
  <section class="page-hero">
    <div class="container">
      <h1>Our Work</h1>
      <p>Over {total.toLocaleString('en-US')} real job-site photos from our metal roofing and insulated panel installations.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="gallery-status" aria-live="polite">Showing {initial.length} of {total} photos</p>

      <div class="gallery-grid" data-reveal-group>
        {
          initial.map((entry, i) => (
            <button type="button" class="gallery-item reveal" data-index={i}>
              <img src={entry.thumb} alt={altFor(i)} loading={i < 8 ? 'eager' : 'lazy'} decoding="async" />
            </button>
          ))
        }
      </div>

      <div class="gallery-sentinel" aria-hidden="true"></div>

      <div class="gallery-load-more">
        <button type="button" class="btn btn--outline gallery-load-more-btn">Load more</button>
      </div>

      <script type="application/json" id="gallery-manifest" is:inline set:html={JSON.stringify(galleryManifest)} />
    </div>
  </section>

  <div class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged photo">
    <button type="button" class="lightbox__close" aria-label="Close">
      <span aria-hidden="true">&times;</span>
    </button>
    <button type="button" class="lightbox__prev" aria-label="Previous photo">
      <span aria-hidden="true">&larr;</span>
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__counter"></figcaption>
    </figure>
    <button type="button" class="lightbox__next" aria-label="Next photo">
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-surface);
  }

  .page-hero p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .gallery-status {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-2);
  }

  .gallery-item {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0;
    cursor: pointer;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms var(--ease-out-quart);
  }

  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    transform: scale(1.05);
  }

  .gallery-sentinel {
    height: 1px;
  }

  .gallery-load-more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: oklch(0.12 0 0 / 0.94);
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  .lightbox.is-open {
    display: flex;
  }

  .lightbox__figure {
    max-width: min(92vw, 1100px);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox__counter {
    color: oklch(1 0 0 / 0.8);
    font-size: 0.9rem;
  }

  .lightbox__close,
  .lightbox__prev,
  .lightbox__next {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: none;
    background: oklch(1 0 0 / 0.12);
    color: oklch(1 0 0 / 0.95);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out-quart);
  }

  .lightbox__close:hover,
  .lightbox__prev:hover,
  .lightbox__next:hover {
    background: oklch(1 0 0 / 0.24);
  }

  .lightbox__close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .lightbox__prev {
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__next {
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .lightbox__prev,
    .lightbox__next {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item img {
      transition: none;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('.gallery-grid');
  const sentinel = document.querySelector<HTMLElement>('.gallery-sentinel');
  const loadMoreBtn = document.querySelector<HTMLButtonElement>('.gallery-load-more-btn');
  const status = document.querySelector<HTMLElement>('.gallery-status');
  const manifestEl = document.getElementById('gallery-manifest');

  type GalleryEntry = { id: string; orientation: string; width: number; height: number; thumb: string; full: string };
  const manifest: GalleryEntry[] = manifestEl ? JSON.parse(manifestEl.textContent || '[]') : [];
  const lang = document.documentElement.lang === 'en' ? 'en' : 'th';
  const BATCH_SIZE = 48;

  function altFor(index: number) {
    return lang === 'en'
      ? `Meechai Steel roofing installation photo ${index + 1}`
      : `ภาพผลงานติดตั้งหลังคาเหล็ก มีชัยสตีล เลขที่ ${index + 1}`;
  }

  function updateStatus(renderedCount: number) {
    if (!status) return;
    status.textContent =
      lang === 'en'
        ? `Showing ${renderedCount} of ${manifest.length} photos`
        : `แสดง ${renderedCount} จาก ${manifest.length} ภาพ`;
  }

  let observer: IntersectionObserver | undefined;

  function makeItem(index: number) {
    const entry = manifest[index];
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'gallery-item';
    btn.dataset.index = String(index);
    const img = document.createElement('img');
    img.src = entry.thumb;
    img.alt = altFor(index);
    img.loading = 'lazy';
    img.decoding = 'async';
    btn.appendChild(img);
    return btn;
  }

  function loadMore() {
    if (!grid) return;
    const renderedCount = grid.children.length;
    const next = manifest.slice(renderedCount, renderedCount + BATCH_SIZE);
    const frag = document.createDocumentFragment();
    next.forEach((_, i) => frag.appendChild(makeItem(renderedCount + i)));
    grid.appendChild(frag);
    const newCount = grid.children.length;
    updateStatus(newCount);
    if (newCount >= manifest.length) {
      loadMoreBtn?.setAttribute('hidden', '');
      observer?.disconnect();
    }
  }

  if (grid) updateStatus(grid.children.length);
  loadMoreBtn?.addEventListener('click', loadMore);

  if ('IntersectionObserver' in window && sentinel) {
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && grid && grid.children.length < manifest.length) loadMore();
        });
      },
      { rootMargin: '600px' },
    );
    observer.observe(sentinel);
  }

  // Lightbox
  const lightbox = document.querySelector<HTMLElement>('.lightbox');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox__img');
  const lightboxCounter = lightbox?.querySelector<HTMLElement>('.lightbox__counter');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__close');
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__prev');
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__next');
  let currentIndex = 0;
  let lastFocused: HTMLElement | null = null;

  function showAt(index: number) {
    if (!manifest.length || !lightboxImg) return;
    currentIndex = ((index % manifest.length) + manifest.length) % manifest.length;
    const entry = manifest[currentIndex];
    lightboxImg.src = entry.full;
    lightboxImg.alt = altFor(currentIndex);
    if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${manifest.length}`;
  }

  function openLightbox(index: number) {
    lastFocused = document.activeElement as HTMLElement | null;
    showAt(index);
    lightbox?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeLightbox() {
    lightbox?.classList.remove('is-open');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  grid?.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest<HTMLElement>('.gallery-item');
    if (item?.dataset.index) openLightbox(Number(item.dataset.index));
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => showAt(currentIndex - 1));
  nextBtn?.addEventListener('click', () => showAt(currentIndex + 1));
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowRight') showAt(currentIndex + 1);
    else if (e.key === 'ArrowLeft') showAt(currentIndex - 1);
    else if (e.key === 'Tab') {
      const focusables = [prevBtn, nextBtn, closeBtn].filter((el): el is HTMLButtonElement => Boolean(el));
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  });
</script>
