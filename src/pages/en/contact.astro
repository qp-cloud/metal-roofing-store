---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { site } from '../../data/site';
import { ChatCircleDotsIcon, PhoneIcon, FacebookLogoIcon } from '@phosphor-icons/react/dist/ssr';
---

<BaseLayout
  lang="en"
  title="Contact Us | Meechai Steel Ltd., Part."
  description="Contact Meechai Steel via LINE or phone — product questions, quotes, or scheduling with our technical team."
>
  <section class="page-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Message or call us directly — our sales and technical teams are ready to help.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <Card
        variant="interactive"
        emphasis="primary"
        class="contact-card contact-card--primary"
        href={site.lineHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <ChatCircleDotsIcon size={28} weight="bold" className="contact-card__icon" aria-hidden="true" />
        <h2>Chat on LINE</h2>
        <p>{site.lineId}</p>
        <span class="contact-card__cta">Open chat &rarr;</span>
      </Card>
      <Card variant="base" class="contact-card">
        <PhoneIcon size={28} weight="bold" className="contact-card__icon" aria-hidden="true" />
        <h2>Call Us</h2>
        <ul class="phone-list">
          {site.phones.map((p) => (
            <li>
              <a href={p.href}>{p.display}</a>
              <span class="phone-list__label">{p.labelEn}</span>
            </li>
          ))}
        </ul>
      </Card>
      <Card variant="interactive" class="contact-card" href={site.facebookHref} target="_blank" rel="noopener noreferrer">
        <FacebookLogoIcon size={28} weight="bold" className="contact-card__icon" aria-hidden="true" />
        <h2>Facebook</h2>
        <p>{site.nameEn}</p>
        <span class="contact-card__cta">Visit page &rarr;</span>
      </Card>
    </div>
  </section>


  <section class="section section--surface">
    <div class="container-narrow">
      <h2>Request a project quote</h2>
      <p class="rfq-lede">
        Send us the following over LINE or by phone and we can price the job properly first time. If you already
        have drawings, send those — our technical team will take off the quantities.
      </p>
      <ol class="rfq-list">
        <li><strong>Type of building</strong> — house, factory, warehouse, cold store or commercial</li>
        <li><strong>Approximate roof or wall area</strong> (sq.m.), or attach the drawings</li>
        <li><strong>System of interest</strong> — metal sheet, PU foam, bolt-type, clip-lock, snap-lock, wall panel</li>
        <li><strong>Thickness and colour</strong> (we can advise if you are not sure yet)</li>
        <li><strong>Run lengths needed and purlin spacing</strong> — both affect cutting and stiffness</li>
        <li><strong>Delivery location</strong> — province, or note if the site is in Lao PDR</li>
        <li><strong>When you need it on site</strong></li>
        <li><strong>Whether you want installation as well</strong></li>
        <li><strong>Invoicing to a company/partnership or an individual</strong></li>
      </ol>
      <div class="hero__actions">
        <a class="btn btn--primary" href={site.lineHref} target="_blank" rel="noopener noreferrer">Send details on LINE</a>
        <a class="btn btn--outline" href={site.phones[0].href}>Call {site.phones[0].display}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-surface);
  }

  .page-hero p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-card--primary p,
  .contact-card--primary .contact-card__cta {
    color: var(--color-primary-ink);
  }

  .contact-card h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .contact-card p {
    color: var(--color-muted);
    margin: 0;
  }

  .contact-card__cta {
    margin-top: var(--space-2);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .branch-mini {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .branch-mini h3 {
    font-size: 1rem;
  }

  .branch-mini a {
    font-weight: 600;
    text-decoration: none;
  }

  .phone-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .phone-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .phone-list a {
    font-weight: 600;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .phone-list__label {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .rfq-lede {
    color: var(--color-muted);
  }

  .rfq-list {
    padding-inline-start: 1.3em;
    line-height: 1.8;
  }

  .rfq-list li {
    margin-bottom: var(--space-1);
  }

  .rfq-list strong {
    color: var(--color-ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
</style>
