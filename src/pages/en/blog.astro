---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  lang="en"
  title="Blog / Roofing Articles | Meechai Steel Ltd., Part."
  description="Educational articles about metal roofing sheets, insulation, and choosing the right roofing system."
>
  <section class="page-hero">
    <div class="container">
      <h1>Blog / Articles</h1>
      <p>Practical knowledge from real job-site experience, to help you decide with confidence.</p>
      <p class="note">Article bodies are currently published in Thai only; titles and summaries are shown here in English.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-auto" data-reveal-group>
        {posts.map((post) => (
          <a class="post-card reveal" href={`/blog/${post.slug}`}>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2>{post.data.titleEn}</h2>
            <p>{post.data.excerptEn}</p>
            <span class="post-card__cta">Read (Thai) &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-surface);
  }

  .page-hero p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .page-hero .note {
    font-size: 0.85rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color 180ms var(--ease-out-quart), transform 180ms var(--ease-out-quart);
  }

  .post-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .post-card time {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .post-card h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .post-card p {
    color: var(--color-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .post-card__cta {
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.9rem;
  }
</style>
