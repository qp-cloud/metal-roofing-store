---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { configuratorUrl } from '../../data/configurator';
import { site } from '../../data/site';
---

<BaseLayout
  lang="en"
  title="3D Roofing Sheet Configurator | Meechai Steel"
  description="Choose profile, thickness, dimensions and colour, see the sheet in 3D, and get coverage, weight and an estimated price instantly."
>
  <section class="page-hero">
    <div class="container">
      <h1>Configure your roofing sheet</h1>
      <p>
        Pick a profile, thickness, length, width and colour and see the result in 3D
        straight away. Coverage, weight and an estimated price update as you go.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="configurator-frame">
        <iframe
          src={`${configuratorUrl}`}
          title="3D roofing sheet configurator"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>

      <p class="configurator-note">
        Not loading, or want it full screen?
        <a href={configuratorUrl} target="_blank" rel="noopener noreferrer">
          Open the configurator in a new tab &rarr;
        </a>
      </p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container cta-band__inner">
      <div>
        <h2>Want a firm price?</h2>
        <p>Send us your configuration on LINE or call the sales team for a quotation based on your actual site.</p>
      </div>
      <div class="hero__actions">
        <a class="btn btn--primary" href={site.lineHref} target="_blank" rel="noopener noreferrer">
          Chat on LINE: {site.lineId}
        </a>
        <a class="btn btn--outline" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .configurator-frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    height: min(84vh, 900px);
  }

  @media (max-width: 900px) {
    .configurator-frame {
      height: min(140vh, 1100px);
    }
  }

  .configurator-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .configurator-note {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
