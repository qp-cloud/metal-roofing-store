---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
---

<BaseLayout
  lang="en"
  title="Brochure | Meechai Steel Ltd., Part."
  description="Download the Meechai Steel product brochure, including specs and contact details."
>
  <section class="page-hero">
    <div class="container">
      <h1>Product Brochure</h1>
      <p>Download our PDF summary of products, specs, and contact channels — share it with your team or project owner.</p>
      <a class="btn btn--primary" href="/brochure/meechai-steel-brochure.pdf" download>
        Download Brochure (PDF)
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Products Included</h2>
      <ul class="brochure-list">
        {products.map((p) => (
          <li>{p.nameEn}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-surface);
  }

  .page-hero p {
    color: var(--color-muted);
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .page-hero .btn {
    margin-top: var(--space-3);
  }

  .brochure-list {
    columns: 2;
    gap: var(--space-5);
    padding-left: 1.2rem;
    color: var(--color-ink);
  }

  .brochure-list li {
    margin-bottom: var(--space-2);
    break-inside: avoid;
  }

  @media (max-width: 600px) {
    .brochure-list {
      columns: 1;
    }
  }
</style>
