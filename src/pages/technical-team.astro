---
import BaseLayout from '../layouts/BaseLayout.astro';
import { team } from '../data/team';
import { site } from '../data/site';
---

<BaseLayout
  lang="th"
  title="ทีมช่างเทคนิค | หจก.มีชัยสตีล"
  description="ทีมช่างเทคนิคและวิศวกรมีชัยสตีล ให้คำปรึกษาโครงสร้างหลังคาและคำนวณปริมาณวัสดุ (Taking-off)"
>
  <section class="page-hero">
    <div class="container">
      <h1>ทีมช่างเทคนิค</h1>
      <p>ให้คำปรึกษาโครงสร้างหลังคา คำนวณปริมาณวัสดุ และออกแบบก่อนเริ่มงานจริง โดยทีมที่มีประสบการณ์ตรงหน้างาน</p>
    </div>
  </section>

  {team.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="grid-auto" data-reveal-group>
        {team.map((m) => (
          <div class="team-card reveal">
            <div class="team-card__avatar" aria-hidden="true">{m.nameTh.slice(-1)}</div>
            <h3>{m.nameTh}</h3>
            <p class="team-card__role">{m.roleTh} · {m.years} ปีประสบการณ์</p>
            <p>{m.bioTh}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <section class="section section--surface">
    <div class="container-narrow">
      <h2>บริการให้คำปรึกษาที่คุณจะได้รับ</h2>
      <ul class="check-list">
        <li>คำนวณปริมาณวัสดุ (Taking-off) ตามแบบก่อสร้าง</li>
        <li>แนะนำระบบยึดที่เหมาะกับความลาดเอียงและสภาพอากาศของพื้นที่</li>
        <li>ตรวจสอบโครงสร้างรองรับก่อนติดตั้งจริง</li>
        <li>ประเมินหน้างานฟรี สำหรับโครงการขนาดกลาง–ใหญ่</li>
      </ul>
      <a class="btn btn--primary" href={site.lineHref} target="_blank" rel="noopener noreferrer">นัดหมายทีมช่างเทคนิค</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-surface);
  }

  .page-hero p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .team-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .team-card__avatar {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .team-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .team-card__role {
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .team-card p:not(.team-card__role) {
    color: var(--color-muted);
    margin: 0;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .check-list li {
    padding-left: 1.6rem;
    position: relative;
  }

  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
