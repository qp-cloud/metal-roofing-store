---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyContact from '../components/StickyContact.astro';
import Schema from '../components/Schema.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  lang: 'th' | 'en';
  title: string;
  description: string;
  /** Site-root path to the social share image. Defaults to /og-default.jpg. */
  image?: string;
  /** Page-specific JSON-LD nodes merged into the site-wide @graph. */
  schema?: Record<string, unknown>[];
}

const { lang, title, description, image, schema = [] } = Astro.props;
const path = Astro.url.pathname;

// --- Canonical + hreflang (Thai at root, English under /en/) ---------------
const isEn = path === '/en' || path.startsWith('/en/');
const thPath = isEn ? (path === '/en' ? '/' : path.slice(3)) : path;
const enPath = thPath === '/' ? '/en' : `/en${thPath}`;
// Blog articles are published in Thai only — no /en/blog/[slug] route.
const hasEnTwin = !/^\/blog\/.+/.test(thPath);

const canonical = new URL(path, Astro.site).href;
const thHref = new URL(thPath, Astro.site).href;
const enHref = new URL(enPath, Astro.site).href;
const ogImage = new URL(image ?? '/og-default.jpg', Astro.site).href;
const siteName = lang === 'en' ? site.nameEn : site.nameTh;
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'th'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    {
      hasEnTwin && (
        <>
          <link rel="alternate" hreflang="th-TH" href={thHref} />
          <link rel="alternate" hreflang="en-US" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={thHref} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'th_TH'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Schema nodes={schema} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="visually-hidden" href="#main-content">{lang === 'en' ? 'Skip to content' : 'ข้ามไปเนื้อหาหลัก'}</a>
    <Header lang={lang} path={path} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyContact lang={lang} />
    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        const groups = new Map<Element, Element[]>();
        document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
          const group = el.closest('[data-reveal-group]') ?? el.parentElement ?? el;
          const list = groups.get(group) ?? [];
          list.push(el);
          groups.set(group, list);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );

        groups.forEach((els) => {
          els.forEach((el, i) => {
            el.classList.add('reveal--pending');
            (el as HTMLElement).style.transitionDelay = `${Math.min(i, 6) * 70}ms`;
            observer.observe(el);
          });
        });
      }
    </script>
  </body>
</html>
