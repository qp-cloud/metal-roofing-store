---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyContact from '../components/StickyContact.astro';
import '../styles/global.css';

interface Props {
  lang: 'th' | 'en';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'th'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2216%22 fill=%22%238c3a2b%22/><text x=%2250%22 y=%2266%22 font-size=%2248%22 fill=%22white%22 text-anchor=%22middle%22 font-family=%22sans-serif%22>MS</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Taviraj:wght@500;600;700&family=Sarabun:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="visually-hidden" href="#main-content">{lang === 'en' ? 'Skip to content' : 'ข้ามไปเนื้อหาหลัก'}</a>
    <Header lang={lang} path={path} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyContact lang={lang} />
    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        const groups = new Map<Element, Element[]>();
        document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
          const group = el.closest('[data-reveal-group]') ?? el.parentElement ?? el;
          const list = groups.get(group) ?? [];
          list.push(el);
          groups.set(group, list);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );

        groups.forEach((els) => {
          els.forEach((el, i) => {
            el.classList.add('reveal--pending');
            (el as HTMLElement).style.transitionDelay = `${Math.min(i, 6) * 70}ms`;
            observer.observe(el);
          });
        });
      }
    </script>
  </body>
</html>
