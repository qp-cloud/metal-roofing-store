# Copy to .env and fill in. .env is gitignored — never commit a real token.

# Page Access Token with pages_read_engagement, for `pnpm run facebook`.
# Get a long-lived one: short-lived tokens expire in about an hour.
FB_PAGE_ACCESS_TOKEN=

# Optional overrides.
# FB_GRAPH_VERSION=v23.0   # match your app's version in the Meta dashboard
# FB_PAGE_ID=              # defaults to the id parsed from site.facebookHref
# FB_POST_LIMIT=50
